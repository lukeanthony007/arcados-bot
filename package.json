{
  "name": "arcados-bot",
  "version": "1.0.0",
  "description": "A minimal Discord bot template with dynamic command support",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:node": "tsx src/main.ts",
    "test:ai": "npx tsx src/scripts/test-ai-assistant.ts",
    "test:conversation": "npx tsx src/scripts/test-conversation-chain.ts",
    "test:discord-stream": "bun run src/features/stream-chrome/tests/test-discord-stream.ts",
    "view-conversations": "bun run src/features/social-intelligence/conversation-detection/scripts/view-conversations.ts",
    "regenerate:conversations": "bun run src/features/social-intelligence/conversation-detection/scripts/regenerate-conversations.ts",
    "analyze:grouping": "bun run src/features/social-intelligence/conversation-detection/scripts/analyze-conversation-grouping.ts",
    "analyze:sorting": "bun run src/features/social-intelligence/conversation-detection/scripts/deep-sorting-analysis.ts",
    "tune:parameters": "bun run src/features/social-intelligence/conversation-detection/scripts/tune-parameters.ts",
    "enrich:conversations": "bun run src/features/social-intelligence/enrichment-pipeline/scripts/enrich-conversations.ts",
    "generate:summaries": "bun run src/features/social-intelligence/enrichment-pipeline/scripts/generate-summaries.ts",
    "keywords:build-vocabulary": "bun run src/features/social-intelligence/semantic-analysis/scripts/build-vocabulary.ts",
    "keywords:extract-all": "bun run src/features/social-intelligence/semantic-analysis/scripts/extract-keywords.ts",
    "diagnose-keywords": "bun run src/features/social-intelligence/semantic-analysis/scripts/diagnose-keywords.ts",
    "check-message": "bun run src/database/scripts/check-message.ts",
    "repair-sync": "bun run src/database/scripts/repair-sync.ts",
    "view-costs": "bun run src/utils/view-costs.ts",
    "profile:users": "tsx src/features/social-intelligence/psychological-profiling/scripts/profile-users.ts",
    "profile:users:stale": "tsx src/features/social-intelligence/psychological-profiling/scripts/profile-stale-users.ts",
    "profile:view-user": "tsx src/features/social-intelligence/psychological-profiling/scripts/view-user-profile.ts",
    "enrich:conversations:24h": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-conversations-manual.ts 24",
    "enrich:conversations:7d": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-conversations-manual.ts 168",
    "enrich:conversations:force": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-conversations-manual.ts --force",
    "enrich:users:24h": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-users-manual.ts 24",
    "enrich:users:7d": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-users-manual.ts 168",
    "enrich:users:stale": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-users-manual.ts --stale",
    "enrich:relationships:24h": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-relationships-manual.ts 24",
    "enrich:relationships:significant": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-relationships-manual.ts --significant",
    "enrich:guild:full": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-guild-manual.ts --full",
    "enrich:guild:summary": "npx tsx src/features/social-intelligence/enrichment-pipeline/scripts/enrich-guild-manual.ts",
    "migrate:voice-state": "tsx src/scripts/migrate-voice-state.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "template",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.69",
    "@cartesia/cartesia-js": "^2.2.9",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.16",
    "@snazzah/davey": "^0.1.8",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^5.0.97",
    "axios": "^1.12.2",
    "chalk": "^5.6.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.1.0",
    "install": "^0.13.0",
    "langchain": "^0.3.36",
    "libsodium-wrappers": "^0.7.15",
    "node-cron": "^4.2.1",
    "opusscript": "^0.0.8",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "prism-media": "^1.3.5",
    "puppeteer": "^24.31.0",
    "puppeteer-stream": "^3.0.22",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "biome": {
    "$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
    "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
    },
    "files": {
      "ignoreUnknown": false,
      "ignore": [
        "node_modules",
        "dist",
        "*.min.js"
      ]
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "tab",
      "indentWidth": 2,
      "lineWidth": 100
    },
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true,
        "complexity": {
          "noExcessiveCognitiveComplexity": "warn"
        },
        "performance": {
          "noAccumulatingSpread": "warn"
        }
      }
    },
    "javascript": {
      "formatter": {
        "quoteStyle": "double",
        "semicolons": "always",
        "trailingCommas": "es5"
      }
    }
  }
}
